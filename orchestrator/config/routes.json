  "routes": {
    "quick": {
      "chain": [
        "local-fast",
        "claude-haiku"
      ]
    },
    "general": {
      "chain": [
        "local-main",
        "claude-sonnet"
      ],
      "memory": true
    },
    "coding": {
      "chain": [
        "codex",
        "local-coder",
        "claude-sonnet"
      ],
      "memory": true
    },
    "review": {
      "chain": [
        "claude-sonnet",
        "local-main"
      ],
      "memory": true
    },
    "planning": {
      "chain": [
        "claude-opus",
        "claude-sonnet",
        "local-main"
      ],
      "memory": true
    },
    "vision": {
      "chain": [
        "local-vision",
        "claude-sonnet"
      ]
    },
    "plan": {
      "chain": [
        "claude-sonnet",
        "codex"
      ],
      "agent": true,
      "readOnly": true,
      "then": "agent",
      "maxTurns": 25,
      "tools": [
        "Read",
        "Glob",
        "Grep"
      ],
      "memory": true
    },
    "agent": {
      "chain": [
        "claude-sonnet",
        "codex"
      ],
      "agent": true,
      "maxTurns": 40,
      "tools": [
        "Bash",
        "Read",
        "Edit",
        "Write",
        "Glob",
        "Grep",
        "WebFetch",
        "WebSearch"
      ],
      "memory": true
    },
    "deep": {
      "chain": [
        "local-deep",
        "local-main",
        "claude-sonnet"
      ],
      "memory": true
    },
    "reasoning": {
      "chain": [
        "local-giant",
        "local-deep",
        "claude-opus"
      ],
      "memory": true
    },
    "video": {
      "chain": [
        "video-wan-fp8",
        "video-wan-q4"
      ]
    },
    "music": {
      "chain": [
        "music-ace-step-15"
      ]
    },
    "image": {
      "chain": [
        "image-qwen-image-2512",
        "image-z-image-base",
        "image-flux2-klein-base",
        "image-realvisxl",
        "image-z-image-turbo",
        "image-flux2-klein",
        "image-qwen-image",
        "image-flux1-dev",
        "image-hidream-fast",
        "image-flux1-schnell",
        "image-sdxl-turbo"
      ]
    },
    "flagship": {
      "chain": [
        "local-giant",
        "local-deep",
        "local-main"
      ],
      "memory": true
    },
    "coding-local": {
      "chain": [
        "local-coder-next",
        "local-coder"
      ],
      "memory": true
    },
    "general-local": {
      "chain": [
        "local-moe-fast",
        "local-main",
        "local-fast"
      ],
      "memory": true
    },
    "image-fast": {
      "chain": [
        "image-flux2-klein",
        "image-z-image-turbo",
        "image-sdxl-turbo"
      ]
    }
  },
  "auto": {
    "chat": "general",
    "act": "agent",
    "plan": "plan",
    "check": [
      "local-main",
      "local-fast",
      "local-vision",
      "local-coder"
    ],
    "fallback": "act",
    "timeoutMs": 8000,
    "coldTimeoutMs": 30000
  },
  "default": "general"
}
