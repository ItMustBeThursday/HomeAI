      "label": "Gemma 4 E4B",
      "note": "Quick replies, small footprint"
    },
    "local-main": {
      "kind": "ollama",
      "model": "homeai-main:locked",
      "category": "General & reasoning",
      "label": "Qwen 3.8 27B",
      "note": "Local shortlist. General chat, research and coding; ~18 GB Q4 weights. Text smoke passed at 4096 context; vision and quality unverified.",
      "recommended": true,
      "ctx": 4096,
      "startTimeoutMs": 240000,
      "vision": true
    },
    "local-coder": {
      "kind": "ollama",
      "model": "homeai-coder:locked",
